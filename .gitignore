# --- Python Caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*
# If you use Jupyter Lab's workspace storage
.jupyter_workspace

# --- Environments & Distribution ---
.env
.venv
env/
venv/
build/
dist/
*.egg-info/
# Mesh archive duplicates of unzipped content
assets/meshes/*.zip

algo_paper/
scripts/*
outputs/

# Keep maintained benchmarks; local experiments stay ignored.
!scripts/__init__.py
!scripts/eqx_model.py
!scripts/gpu_memory.py
!scripts/bench/
scripts/bench/*
!scripts/bench/mesh_extraction/
