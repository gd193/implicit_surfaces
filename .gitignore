# --- Python Caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
*/.ipynb_checkpoints/*
# If you use Jupyter Lab's workspace storage
.jupyter_workspace

# --- Environments & Distribution ---
.env
.venv
env/
venv/
build/
dist/
*.egg-info/
# Mesh archive duplicates of unzipped content
assets/meshes/*.zip

algo_paper/
scripts/*
assets/

# Keep the Warp BVH benchmark reproducible without exposing other local
# research scripts or generated benchmark data.
!scripts/bench/
scripts/bench/*
!scripts/bench/spatial_trees/
scripts/bench/spatial_trees/*
!scripts/bench/spatial_trees/_warp_fixtures.py
!scripts/bench/spatial_trees/warp_bvh_device.py
!scripts/bench/spatial_trees/_warp_cases.py
!scripts/bench/spatial_trees/warp_query_matrix.py
!scripts/bench/spatial_trees/_warp_timing.py
